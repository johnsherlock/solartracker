# Environment variables for apps/web.
#
# Local: copy to .env (or .env.local) and fill in what you need. Only
# DATABASE_URL is required to run the app against the Docker Postgres.
# Preview / Production: set these in the Vercel project settings, scoped to the
# matching environment. See docs/deployment.md for per-environment values.

# --- Database ---------------------------------------------------------------
# Local Docker default shown. Hosted: the Neon connection string (separate Neon
# projects for Production and Preview).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pv_manager

# --- Auth (Google sign-in via NextAuth) --------------------------------------
# Random secret that signs session tokens. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical app URL. Production: https://www.solartracker.app
# Preview: leave unset (NextAuth falls back to the deployment URL on Vercel).
NEXTAUTH_URL=http://localhost:3000
# Google OAuth client. Production redirect URI:
#   https://www.solartracker.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin / operator login --------------------------------------------------
# Signs the admin session cookie. Optional — falls back to NEXTAUTH_SECRET.
# ADMIN_SESSION_SECRET=
# Read only by `npm run db:seed` and `npm run db:create-admin`, not at runtime.
# Do not set these in Vercel.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# --- Background jobs ----------------------------------------------------------
# Bearer secret Vercel Cron sends to /api/internal/jobs/daily-summary.
# At least 16 random characters. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Provider credentials -----------------------------------------------------
# Encrypts stored MyEnergi credentials. Exactly 64 hex characters (32 bytes).
# Generate: openssl rand -hex 32. Use a different key per environment, and never
# rotate it in Production without re-encrypting stored credentials.
CREDENTIAL_ENCRYPTION_KEY=
# Only for the seeded fixture user (credential ref env:MYENERGI_USERNAME:...).
# Local and Preview only — never set in Production.
# MYENERGI_USERNAME=
# MYENERGI_PASSWORD=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# Optional — defaults to noreply@solartracker.app
# FROM_EMAIL=

# --- Location ------------------------------------------------------------------
# Geoapify key for address lookup in Settings → Location.
GEOAPIFY_API_KEY=
